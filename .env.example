# ==========================================
# NorthStar Retail - Environment Configuration
# ==========================================

# Execution Mode: 'mock' (standalone local without GCP credentials) or 'gcp' (live GCP project)
EXECUTION_MODE=mock

# GCP Project Settings (Required if EXECUTION_MODE=gcp)
GCP_PROJECT_ID=northstar-retail-dev
GCP_REGION=asia-south1
GCS_LANDING_BUCKET=northstar-retail-landing-zone
GCS_PROCESSED_BUCKET=northstar-retail-processed-zone
BIGQUERY_DATASET=northstar_retail_mart

# AI / LLM Configuration
# Optional: Google AI Studio API Key (if provided in mock mode, enables live Gemini model; otherwise uses local mock LLM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Logging & Paths
LOG_LEVEL=INFO
DATA_DIR=./data
PROCESSED_DATA_DIR=./data/processed
